{
  "name": "cfr-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
